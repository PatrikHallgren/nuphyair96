{
  "id": "firefox",
  "name": "Firefox",
  "match": {
    "class": ["firefox", "firefox-esr", "org.mozilla.firefox"],
    "title_contains": []
  },
  "keys": [
    {"key": "t", "mods": ["ctrl"], "label": "New tab", "color": "#89b4fa"},
    {"key": "w", "mods": ["ctrl"], "label": "Close tab", "color": "#f7768e"},
    {"key": "l", "mods": ["ctrl"], "label": "Address bar", "color": "#e0af68"},
    {"key": "r", "mods": ["ctrl"], "label": "Reload", "color": "#9ece6a"},
    {"key": "f", "mods": ["ctrl"], "label": "Find", "color": "#bb9af7"}
  ]
}
